{
	"name": "pi-my-pi",
	"version": "0.1.0",
	"description": "Personal pi extensions: live token speed in the status bar, unified /my-pi settings menu, and more.",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"author": "elpaca",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/elpaca/pi-my-pi.git"
	},
	"engines": {
		"node": ">=20"
	},
	"pi": {
		"extensions": [
			"./extensions/my-pi/index.ts"
		]
	},
	"files": [
		"extensions",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"check": "npm run typecheck && npm run lint && npm run test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@earendil-works/pi-ai": "1.0.0",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@earendil-works/pi-tui": "1.0.0",
		"@types/node": "26.6.4",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	}
}
